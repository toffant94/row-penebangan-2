{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "package": {
    "productName": "PLN ROW Trimming Manager",
    "version": "1.0.0"
  },
  "app": {
    "windows": [
      {
        "title": "PLN ROW Trimming Manager - Sistem Laporan Perabasan Pohon",
        "width": 1280,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Sistem Laporan Pemeliharaan ROW Jaringan PLN",
    "longDescription": "Aplikasi pengelolaan dan pelaporan perabasan pohon pemeliharaan jaringan 20kV PLN dari format Excel multi-kolom ke cetak resmi A4/F4.",
    "copyright": "PT PLN (Persero)"
  }
}
